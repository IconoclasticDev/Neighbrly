# Neighbrly Web (Vite) — CARTO Basemap Key Template
# Browser-side tile keys are visible in network requests. Restrict by HTTP referrer and quota.
# Confirm the key is a CARTO Basemaps raster tile key, not a CARTO Platform JWT access token.
VITE_CARTO_BASEMAP_KEY=your_carto_basemap_key_here

# Optional signup API; must persist consent and return {"registered":true} on success.
# Leave unset to show registration coming soon.
# VITE_PILOT_SIGNUP_URL=https://your-api.example/v1/pilot
